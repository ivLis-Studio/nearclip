      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 휴대폰이나 카메라가 있는 컴퓨터에서 이 코드를 스캔할 수 있습니다."
          }
        }
      }
    },
    "Approve this device in the Tailscale admin console.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 관리 콘솔에서 이 기기를 승인하세요."
