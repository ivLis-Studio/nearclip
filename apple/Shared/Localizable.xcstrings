      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나가기"
          }
        }
      }
    },
    "Leave My Devices": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 기기에서 나가기"
          }
        }
      }
    },
