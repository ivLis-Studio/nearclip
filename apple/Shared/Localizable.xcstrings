      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하지 못함"
          }
        }
      }
    },
    "Couldn't reach the device. Make sure both devices are on the same Wi-Fi, or turn on Remote connection on both.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 연결할 수 없습니다. 두 기기가 같은 Wi-Fi에 있는지 확인하거나, 두 기기 모두 원격 연결을 켜세요."
          }
        }
      }
    },
    "Couldn't receive the image": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 받지 못했습니다"
          }
        }
      }
    },
    "Couldn't start remote connection. %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 연결을 시작할 수 없습니다. %@"
