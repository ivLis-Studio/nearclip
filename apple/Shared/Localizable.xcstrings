      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사한 다음 붙여넣기 누르기"
          }
        }
      }
    },
    "Couldn't change the login item": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 항목을 변경할 수 없음"
