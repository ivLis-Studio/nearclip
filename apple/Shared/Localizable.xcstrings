        }
      }
    },
    "Copy here. Paste there.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 복사하고, 저기서 붙여넣기."
          }
        }
      }
    },
    "Copy in any app, then tap Paste": {
      "localizations": {
