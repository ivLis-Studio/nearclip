      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 클립 자동으로 복사"
          }
        }
      }
    },
    "Copy it again on %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 다시 복사해 보세요."
          }
        }
      }
    },
    "Copy something on any of your devices.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 기기에서든 무언가를 복사해 보세요."
