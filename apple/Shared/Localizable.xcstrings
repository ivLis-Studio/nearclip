    "Nearclip couldn't start": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearclip을 시작할 수 없음"
          }
        }
      }
    },
    "Nearclip keeps the clipboard of your devices in sync over your Wi-Fi. Nothing leaves your network.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearclip은 Wi-Fi로 내 기기들의 클립보드를 동기화합니다. 어떤 데이터도 네트워크 밖으로 나가지 않습니다."
          }
        }
      }
    },
    "Nearclip looks for your computers and phones on this Wi-Fi. When iOS asks, choose Allow.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearclip이 이 Wi-Fi에서 내 컴퓨터와 휴대폰을 찾습니다. iOS가 물어보면 ‘허용’을 선택하세요."
          }
        }
      }
    },
    "Nearclip needs the camera to scan the code.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 스캔하려면 카메라 접근이 필요합니다."
          }
        }
      }
    },
    "Nearclip only asks for what it needs to sync.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearclip은 동기화에 필요한 권한만 요청합니다."
          }
        }
      }
    },
    "Nearclip presses ⌘V for you in the app you were using.": {
