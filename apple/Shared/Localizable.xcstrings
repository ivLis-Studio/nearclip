    "Image from %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 받은 이미지"
          }
        }
      }
    },
    "Image syncing is off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 동기화가 꺼져 있음"
          }
        }
      }
    },
    "Image · %lld×%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Image · %1$lld×%2$lld"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 · %lld×%lld"
          }
        }
      }
    },
    "Images": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지"
          }
        }
      }
    },
    "In Settings › Nearclip › Paste from Other Apps, choose Allow — otherwise iOS asks every time.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › Nearclip › 다른 앱에서 붙여넣기에서 ‘허용’을 선택하세요. 그렇지 않으면 iOS가 매번 묻습니다."
          }
        }
      }
    },
    "Install Nearclip on your other devices, then scan the code or pick them below.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에 Nearclip을 설치한 뒤 코드를 스캔하거나 아래에서 선택하세요."
          }
        }
      }
    },
    "It turns back on when you resume syncing.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 다시 시작하면 원격 연결도 다시 켜집니다."
          }
        }
      }
    },
    "It will stop syncing with your devices.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 내 기기와 동기화되지 않습니다."
          }
        }
      }
    },
    "Items that password managers mark as private are never recorded or synced.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호 관리자가 비공개로 표시한 항목은 기록하거나 동기화하지 않습니다."
          }
        }
      }
    },
    "Join": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참여"
          }
        }
      }
    },
    "Just now": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금"
          }
        }
      }
    },
    "KakaoTalk codes can't be read on iPhone — iOS gives apps no way to see them.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카카오톡 인증번호는 iPhone에서 읽을 수 없습니다. iOS가 앱에 그 방법을 열어 두지 않았습니다."
          }
        }
      }
    },
    "Keep history for": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 보관 기간"
          }
        }
      }
    },
    "Keeps your devices connected on different networks — home, office or mobile data. Uses a free Tailscale account; clips stay end-to-end encrypted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집, 회사, 모바일 데이터처럼 서로 다른 네트워크에서도 기기끼리 연결됩니다. 무료 Tailscale 계정을 사용하며, 클립은 계속 종단 간 암호화됩니다."
          }
        }
      }
    },
    "Last seen %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 연결됨"
          }
        }
      }
    },
