    },
    "Choose Message. Leave Sender and Message Contains empty — Nearclip finds the code itself.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘메시지’를 고르세요. 보낸 사람과 메시지 내용 조건은 비워 두세요. 인증번호는 Nearclip이 찾아냅니다."
          }
        }
      }
    },
    "Choose Run Immediately, turn off Notify When Run, then tap Next.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘즉시 실행’을 고르고 ‘실행 시 알림’을 끈 다음 ‘다음’을 누르세요."
          }
        }
      }
    },
