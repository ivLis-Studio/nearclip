      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사"
          }
        }
      }
    },
    "Copy here.\nPaste there.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 복사하고,\n저기서 붙여넣기."
