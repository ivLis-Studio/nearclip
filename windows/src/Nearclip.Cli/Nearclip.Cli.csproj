<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless peer for tools/interop (PROTOCOL.md §9). Runs on macOS, Linux and Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Nearclip.Cli</AssemblyName>
    <RootNamespace>Nearclip.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nearclip.Core\Nearclip.Core.csproj" />
  </ItemGroup>
</Project>
