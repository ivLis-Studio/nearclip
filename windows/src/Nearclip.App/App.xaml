<Application
    x:Class="Nearclip.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="IrisBrush" Color="#4C5BF5" />
                    <SolidColorBrush x:Key="IrisSubtleBrush" Color="#1F4C5BF5" />
                    <SolidColorBrush x:Key="IrisFaintBrush" Color="#0F4C5BF5" />
                    <SolidColorBrush x:Key="OnlineBrush" Color="#1E9E5A" />
                    <SolidColorBrush x:Key="OnlineDotBrush" Color="#2FBF71" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#B86E00" />
                    <SolidColorBrush x:Key="WarningDotBrush" Color="#F5A524" />
                    <SolidColorBrush x:Key="OfflineDotBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4C5BF5" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64C5BF5" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4C5BF5" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#3A47D1" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#2B35A8" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#4C5BF5" />
                    <SolidColorBrush x:Key="FlyoutDividerBrush" Color="#14000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="IrisBrush" Color="#8B96FF" />
                    <SolidColorBrush x:Key="IrisSubtleBrush" Color="#2E8B96FF" />
                    <SolidColorBrush x:Key="IrisFaintBrush" Color="#178B96FF" />
                    <SolidColorBrush x:Key="OnlineBrush" Color="#4FD58C" />
                    <SolidColorBrush x:Key="OnlineDotBrush" Color="#2FBF71" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F5B54A" />
                    <SolidColorBrush x:Key="WarningDotBrush" Color="#F5A524" />
                    <SolidColorBrush x:Key="OfflineDotBrush" Color="#7A7A7A" />
                    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#8B96FF" />
                    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E68B96FF" />
                    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC8B96FF" />
                    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#B4BBFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#B4BBFF" />
                    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#8B96FF" />
                    <SolidColorBrush x:Key="FlyoutDividerBrush" Color="#1AFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="IrisBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="IrisSubtleBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="IrisFaintBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="OnlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OnlineDotBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WarningDotBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="OfflineDotBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="FlyoutDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Brand accent (DESIGN.md §2): Iris #4C5BF5 in light mode, #8B96FF in dark mode. -->
            <Color x:Key="SystemAccentColor">#5A68F7</Color>
            <Color x:Key="SystemAccentColorLight1">#737FFA</Color>
            <Color x:Key="SystemAccentColorLight2">#8B96FF</Color>
            <Color x:Key="SystemAccentColorLight3">#B4BBFF</Color>
            <Color x:Key="SystemAccentColorDark1">#4C5BF5</Color>
            <Color x:Key="SystemAccentColorDark2">#3A47D1</Color>
            <Color x:Key="SystemAccentColorDark3">#2B35A8</Color>

            <FontFamily x:Key="Icons">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>

            <!-- Transparent icon button with a subtle hover fill (Windows 11 "subtle" button). -->
            <Style x:Key="SubtleIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="7" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>

            <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="CaptionSecondary" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- Six-digit pairing code, grouped "123 456". -->
            <Style x:Key="CodeDigitsStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="34" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource IrisBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!--
                Theme-aware styles for elements built in code. A brush read from Application.Current.Resources is the
                application-theme brush (the system theme), not the brush of the window's light/dark choice, and it
                never updates. ThemeResource setters are resolved per element and follow theme and high-contrast changes.
            -->
            <Style x:Key="TextSecondary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="TextTertiary" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
            <Style x:Key="TextOnline" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource OnlineBrush}" />
            </Style>
            <Style x:Key="TextWarning" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource WarningBrush}" />
            </Style>
            <Style x:Key="IconIris" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource IrisBrush}" />
            </Style>
            <Style x:Key="IconSecondary" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="IconOnline" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource OnlineBrush}" />
            </Style>
            <Style x:Key="IconWarning" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource WarningBrush}" />
            </Style>
            <Style x:Key="TileIris" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource IrisSubtleBrush}" />
            </Style>
            <Style x:Key="TileSubtle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ChipIris" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource IrisFaintBrush}" />
            </Style>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="CardGrid" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="DotOnline" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource OnlineDotBrush}" />
            </Style>
            <Style x:Key="DotOffline" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource OfflineDotBrush}" />
            </Style>
            <Style x:Key="DotWarning" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource WarningDotBrush}" />
            </Style>
            <!-- Status dot drawn over an avatar: ring in the surface colour. -->
            <Style x:Key="DotOnlineRinged" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource OnlineDotBrush}" />
                <Setter Property="Stroke" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            </Style>
            <Style x:Key="AvatarIris" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource IrisSubtleBrush}" />
                <Setter Property="Stroke" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="AvatarSubtle" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Stroke" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="BadgeIris" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource IrisSubtleBrush}" />
            </Style>
            <Style x:Key="PagerActive" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource IrisBrush}" />
            </Style>
            <Style x:Key="PagerInactive" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource ControlStrongFillColorDisabledBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
