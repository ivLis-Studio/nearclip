<Project Sdk="Microsoft.NET.Sdk">
  <!-- Nearclip for Windows: WinUI 3 / Windows App SDK, unpackaged, self-contained, x64 + ARM64. Builds on Windows only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Nearclip.App</RootNamespace>
    <AssemblyName>Nearclip</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Nearclip.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Self-contained needs a RID: follow the solution platform when none is given (dotnet build Nearclip.slnx -p:Platform=ARM64). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;CS8305</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nearclip.Core\Nearclip.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Microsoft Store edition (scripts\package-msix.ps1): the same app as an MSIX package with the manifest and logos in
       ..\..\packaging. dotnet publish … -p:NearclipStore=true writes an unsigned .msix to artifacts\msix (the Store signs it). -->
  <PropertyGroup Condition="'$(NearclipStore)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <GenerateTestArtifacts>false</GenerateTestArtifacts>
    <AppxPackageDir>$(MSBuildProjectDirectory)\..\..\artifacts\msix\</AppxPackageDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(NearclipStore)' == 'true'">
    <AppxManifest Include="..\..\packaging\Package.appxmanifest" />
    <Content Include="..\..\packaging\Images\*.png" Link="Images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Embedded Tailscale node (tailnet/build.sh windows): nctailnet.dll next to Nearclip.exe. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <None Include="..\..\native\win-arm64\nctailnet.dll" Link="nctailnet.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <None Include="..\..\native\win-x64\nctailnet.dll" Link="nctailnet.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckTailnetLibrary" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' != ''">
    <Error Condition="!Exists('..\..\native\$(RuntimeIdentifier)\nctailnet.dll')" Text="Missing native\$(RuntimeIdentifier)\nctailnet.dll — run tailnet/build.sh windows first." />
  </Target>
  <!-- Licenses of everything inside nctailnet.dll (tailnet/build.sh notices); Settings › About opens it. -->
  <ItemGroup>
    <Content Include="..\..\..\tailnet\notices\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
