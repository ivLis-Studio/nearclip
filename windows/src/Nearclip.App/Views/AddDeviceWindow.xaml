<Window
    x:Class="Nearclip.App.Views.AddDeviceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Nearclip.App.Model"
    xmlns:v="using:Nearclip.App.Views">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="40" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/win-32.png" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="{m:Str Key=AddDevice}" />
        </Grid>
        <v:AddDeviceView x:Name="View" Grid.Row="1" />
    </Grid>
</Window>
