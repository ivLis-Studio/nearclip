<UserControl
    x:Class="Nearclip.App.Views.ClipRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Nearclip.App.Model">
    <Grid x:Name="Root"
          Padding="0,7,0,7"
          Background="Transparent"
          ColumnSpacing="10"
          PointerEntered="Root_PointerEntered"
          PointerExited="Root_PointerExited">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Width="36" Height="36" VerticalAlignment="Center">
            <Border x:Name="GlyphTile" CornerRadius="7" Style="{StaticResource TileSubtle}">
                <FontIcon x:Name="Glyph" FontFamily="{StaticResource Icons}" FontSize="15" Style="{StaticResource IconSecondary}" />
            </Border>
            <Border x:Name="ThumbTile"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                <Image x:Name="Thumb" Stretch="UniformToFill" />
            </Border>
            <Border x:Name="Swatch"
                    Margin="4"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="Title"
                       FontSize="13"
                       MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"><Run x:Name="TitleMain" /><Run x:Name="TitleExtra" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></TextBlock>
            <Grid ColumnSpacing="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="SourceGlyph"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource Icons}"
                          FontSize="10.5"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="Caption"
                           Grid.Column="1"
                           FontSize="11.5"
                           MaxLines="1"
                           Style="{StaticResource TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
                <FontIcon x:Name="PinGlyph"
                          Grid.Column="2"
                          VerticalAlignment="Center"
                          FontFamily="{StaticResource Icons}"
                          FontSize="10.5"
                          Foreground="{ThemeResource IrisBrush}"
                          Glyph="&#xE840;"
                          Visibility="Collapsed" />
            </Grid>
        </StackPanel>
        <Grid Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="Shortcut"
                       Margin="0,0,4,0"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <StackPanel x:Name="HoverActions" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="PinButton" Click="PinButton_Click" Style="{StaticResource SubtleIconButton}">
                    <FontIcon x:Name="PinButtonGlyph" FontFamily="{StaticResource Icons}" FontSize="12" Glyph="&#xE718;" />
                </Button>
                <Button x:Name="DeleteButton" Click="DeleteButton_Click" Style="{StaticResource SubtleIconButton}">
                    <FontIcon FontFamily="{StaticResource Icons}" FontSize="12" Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
