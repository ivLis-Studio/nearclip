<Window
    x:Class="Nearclip.App.Views.PairPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="32" />
        <StackPanel x:Name="Body" Grid.Row="1" Padding="26,0,26,8" VerticalAlignment="Center" Spacing="12" />
        <Grid x:Name="Buttons" Grid.Row="2" Padding="24,16,24,20" ColumnSpacing="10" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="DeclineButton" HorizontalAlignment="Stretch" Click="Decline_Click" />
            <Button x:Name="AddButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="Add_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
