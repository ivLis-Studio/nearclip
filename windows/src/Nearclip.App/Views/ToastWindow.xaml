<Window
    x:Class="Nearclip.App.Views.ToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root"
          Padding="12,10,16,10"
          Background="Transparent"
          ColumnSpacing="11"
          PointerEntered="Root_PointerEntered"
          PointerExited="Root_PointerExited"
          Tapped="Root_Tapped">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="IconGrid" Width="32" Height="32" VerticalAlignment="Center">
            <Ellipse x:Name="AccentCircle" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Ellipse x:Name="WarningCircle" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
            <FontIcon x:Name="DeviceGlyph" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" MaxLines="1" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PreviewText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis" />
            <!-- A large image on its way (PROTOCOL.md §6.6): bar and "3.1 / 8.0 MB" in place of the preview line -->
            <Grid x:Name="ProgressRow" ColumnSpacing="8" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Progress" VerticalAlignment="Center" Minimum="0" Maximum="1000" />
                <TextBlock x:Name="ProgressText" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <!-- A verification code from a phone (PROTOCOL.md §6.7): the code, Copy and Not now -->
            <StackPanel x:Name="CodePanel" Spacing="8" Margin="0,2,0,0" Visibility="Collapsed">
                <TextBlock x:Name="CodeText" FontSize="26" FontWeight="Bold" CharacterSpacing="120" />
                <StackPanel x:Name="CodeButtons" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyButton" Style="{StaticResource AccentButtonStyle}" MinWidth="76" Click="Copy_Click" />
                    <Button x:Name="NotNowButton" MinWidth="76" Click="NotNow_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Border x:Name="ThumbBorder" Grid.Column="2" Width="38" Height="38" CornerRadius="6" Visibility="Collapsed"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Grid>
                <FontIcon x:Name="ThumbPlaceholder" FontFamily="{StaticResource Icons}" Glyph="&#xE91B;" FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Image x:Name="Thumb" Stretch="UniformToFill" />
            </Grid>
        </Border>
    </Grid>
</Window>
