<Window
    x:Class="Nearclip.App.Views.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:Nearclip.App.Model">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Height="36" />

        <Grid x:Name="StepHost" Grid.Row="1">
            <!--  1 · Welcome  -->
            <ScrollViewer x:Name="Step0">
                <StackPanel MaxWidth="548" Padding="36,0,36,16" HorizontalAlignment="Center" Spacing="12">
                    <Image Width="76" Height="76" HorizontalAlignment="Center" Source="ms-appx:///Assets/win-256.png" />
                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="Bold" LineHeight="36" Text="{m:Str Key=Tagline_TwoLines}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{m:Str Key=Onb_WelcomeBody}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
                    <StackPanel x:Name="Features" Margin="0,6,0,0" Spacing="12" />
                </StackPanel>
            </ScrollViewer>

            <!--  2 · Quick setup (Windows: firewall, shortcut, start at sign-in)  -->
            <ScrollViewer x:Name="Step1" Visibility="Collapsed">
                <StackPanel MaxWidth="520" Padding="36,8,36,20" Spacing="12">
                    <TextBlock FontSize="26" FontWeight="Bold" Text="{m:Str Key=Onb_SetupTitle}" />
                    <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{m:Str Key=Onb_SetupBody}" TextWrapping="WrapWholeWords" />
                    <StackPanel x:Name="Checks" Margin="0,6,0,0" Spacing="10" />
                </StackPanel>
            </ScrollViewer>

            <!--  3 · Add your devices  -->
            <Grid x:Name="Step2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Padding="36,4,36,4" Spacing="6">
                    <TextBlock FontSize="26" FontWeight="Bold" Text="{m:Str Key=Onb_DevicesTitle}" />
                    <TextBlock FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{m:Str Key=Onb_DevicesBody}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <Grid x:Name="AddHost" Grid.Row="1" Margin="6,0,6,0" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="22,14,22,16" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Dots" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6" />
            <Button x:Name="BackButton" Grid.Column="1" MinWidth="96" Click="Back_Click" Content="{m:Str Key=Back}" />
            <Button x:Name="NextButton" Grid.Column="2" MinWidth="120" Click="Next_Click" Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
